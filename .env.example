# Default keeps local development and automated tests deterministic.
AI_PROVIDER=mock

# To use Gemini through Vertex AI with Application Default Credentials.
# AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=true
# VERTEX_AI_MODEL=gemini-2.5-flash

# To use an OpenAI-compatible Qwen gateway, set these only in .env.local.
# AI_PROVIDER=qwen
# AI_BASE_URL=https://your-openai-compatible-gateway.example/v1
# AI_MODEL=your-qwen-model
# AI_API_KEY=replace-with-a-rotated-server-side-key

# To use Google Gemini directly, set these only in .env.local.
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_API_KEY=replace-with-a-rotated-server-side-key
